load %r0, [ring_m + 0].output
print %r0
call pop
load %r0, [ring_m + 0].output
print %r0
call pop
load %r0, [ring_m + 0].output
print %r0
call pop
load %r0, [ring_m + 0].output
print %r0

call pop
load %r0, [ring_m + 0].status
print %r0
load %r0, [ring_m + 0].count
print %r0
ret
