{
  // build_compiler.sh uses unique outputs to keep parallel builds atomic.
  "langrev": "1",
  "warnings": [ "no-unused" ],
  "dependency-search-paths": [ ],
  "dependencies": [ ],
  "authors": [ "wtorso <41353182+wtorso@users.noreply.github.com>" ],
  "version": "0.2.0",
  "sources": [ ],
  "test-sources": [ ],
  "build-dir": "build",
  "output": "build/bin",
  "targets": {
    "rez3asm": {
      "type": "executable",
      "sources": [
        "src/rez3asm.c3",
        "src/compiler/model.c3",
        "src/compiler/layout.c3",
        "src/compiler/checker.c3",
        "src/compiler/emitter.c3",
        "src/lsp_server.c3",
        "src/lsp_navigation.c3",
        "src/lsp_completion.c3",
        "src/lsp_references.c3",
        "src/memory_guard.c3",
        "src/scratch_memory.c3"
      ]
    },
    "rza_tests": {
      "type": "executable",
      "sources": [
        "tests/runner.c3",
        "tests/harness.c3",
        "tests/function_length.c3",
        "tests/source_style.c3",
        "tests/deterministic_artifacts.c3",
        "tests/tiny_budgets.c3",
        "tests/fuzz_smoke.c3",
        "tests/ownership_model.c3",
        "tests/ownership_fuzz.c3",
        "tests/execution_oracle.c3",
        "tests/execution_proc_oracle.c3",
        "tests/execution_proc_model.c3",
        "tests/execution_cascade_oracle.c3",
        "tests/execution_cascade_model.c3",
        "tests/execution_shrink.c3",
        "tests/execution_coverage.c3",
        "tests/lsp_client.c3",
        "tests/fault_scenarios.c3",
        "tests/fault_smoke.c3",
        "tests/proc_contracts.c3",
        "tests/lsp_smoke.c3",
        "tests/lsp_navigation_smoke.c3",
        "tests/lsp_completion_smoke.c3",
        "tests/lsp_references_smoke.c3",
        "tests/lsp_memory_posix.c3",
        "tests/lsp_memory_win32.c3"
      ]
    }
  },
  "cpu": "generic",
  "opt": "O0"
}
