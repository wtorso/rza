res state, field, 8
med state_m, state, field

proc reset:
    mov %r0, 0
    store [state_m + 0], %r0
    ret

proc work:
    load %r0, [state_m + 0]
    add %r0, %r0, 3
    store [state_m + 0], %r0
    ret

proc workload:
    call reset
    mov %r1, 0
call_loop:
    slt %r2, %r1, 1024
    brz %r2, call_done
    call work
    inc %r1
    jmp call_loop
call_done:
    ret
ret
