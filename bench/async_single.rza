; One task per boot: 1024 state increments and 1024 completed notifications.
res state, field, 8
res completed, field, 8
med state_m, state, field
med completed_m, completed, field

proc work:
    acasc bump: state_m -> out
        load %r0, [state_m + 0]
        inc %r0
        store [state_m + 0], %r0
    endc
    med out_m, out, field
    await %r0
    store [completed_m + 0], %r0
    ret
ret
