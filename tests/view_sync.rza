res raw, field, 32
med raw_m, raw, field
casc slice: raw_m -> out[field]
    mov %r0, 40
    store [raw_m + 8], %r0
    mov %r1, 8
    view local_m, raw_m, %r1, 16
    load %r2, [local_m + 0]
    print %r2
    view nested_m, local_m, 4, 8
    mov %r3, 41
    store [nested_m + 0], %r3
    load %r4, [local_m + 4]
    print %r4
endc
ret
