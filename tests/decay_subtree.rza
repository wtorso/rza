; decay убивает поддерево рекурсивно (модель §0): рантайм обязан совпадать
; с чекером (kill рекурсивен). Раньше runtime-decay гасил только саму
; рамку — потомок оставался жив (расход с моделью по I2/I3, review #1).
cav  a, field
cav  b, a
res  y, b, 8
med  y_m, y, field
probe y_m          ; ALIVE: b жива, медиатор жив
decay a            ; поддерево (b, y, y_m) мертво рекурсивно
probe y_m          ; DEAD: владелец b убит decay-ом предка a
ret
