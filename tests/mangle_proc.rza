; манглинг рамок (review #3): рамка proc_k (верхний уровень) и рамка
; процедуры k — РАЗНЫЕ сущности. Раньше обе становились f_proc_k:
; конфликт типов в сгенерированном C (не компилируется).
cav  proc_k, field
res  x, proc_k, 8
med  x_m, x, proc_k
proc k:
    ret
call k
probe x_m          ; ALIVE: proc_k — обычная рамка, вызов k её не трогает
decay proc_k
probe x_m          ; DEAD: владелец мёртв
ret
