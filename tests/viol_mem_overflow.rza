; STRUCT: смещение вне i32 отклоняется, не заворачивается (SPEC §9).
res  acc, field, 16
med  acc_m, acc, field
load  %r0, [acc_m + 99999999999]   ; VIOLATION [STRUCT]: offset out of i32
loadb %r1, [acc_m + 99999999999]   ; VIOLATION [STRUCT]: тот же parse_mem
store [acc_m + 99999999999], %r1   ; VIOLATION [STRUCT]: тот же parse_mem
ret
