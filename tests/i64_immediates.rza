mov %r0, 9223372036854775807
print %r0                  ; INT64_MAX
mov %r1, -9223372036854775808
print %r1                  ; INT64_MIN
mov %r2, 0xffffffffffffffff
print %r2                  ; -1: все 64 бита установлены
mov %r3, 0x8000000000000000
print %r3                  ; INT64_MIN как битовый образ
add %r4, %r0, -9223372036854775808
print %r4                  ; -1: INT64_MAX + INT64_MIN
ret
