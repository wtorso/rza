mov %r0, -1
slt %r1, %r0, 0
print %r1                  ; 1: -1 < 0
slt %r2, %r0, -2
print %r2                  ; 0: -1 >= -2
mov %r3, -9223372036854775808
slt %r4, %r3, 9223372036854775807
print %r4                  ; 1: INT64_MIN < INT64_MAX
mov %r5, 9223372036854775807
slt %r6, %r5, -9223372036854775808
print %r6                  ; 0: INT64_MAX >= INT64_MIN
ret
