res raw, field, 4
med raw_m, raw, field
mov.i16 %r0, 0xffff
print %r0
mov.u16 %r1, 0x000ffff
print %r1
store.i16 [raw_m + 1], %r0
load.i16 %r2, [raw_m + 1]
print %r2
store.u16 [raw_m + 0], %r1
load.u16 %r2, [raw_m + 0]
print %r2
mov %r3, 0x1ffff
mov.i16 %r4, %r3
print %r4
mov.u16 %r5, %r3
print %r5
view raw_v_m, raw_m, 1, 2
store.i16 [raw_v_m + 0], %r0
load.i16 %r6, [raw_v_m + 0]
print %r6
mov.u16 %r6, 0x2211
store.u16 [raw_m + 0], %r6
mov.u16 %r6, 0x4433
store.u16 [raw_m + 2], %r6
store.i16 [raw_m + 1], %r0
load.u8 %r7, [raw_m + 0]
print %r7
load.u8 %r7, [raw_m + 3]
print %r7
mov.u16 %r6, 0x6655
store.u16 [raw_m + 0], %r6
mov.u16 %r6, 0x8877
store.u16 [raw_m + 2], %r6
store.u16 [raw_m + 0], %r1
load.u8 %r7, [raw_m + 2]
print %r7
load.u8 %r7, [raw_m + 3]
print %r7
ret
