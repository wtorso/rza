layout Pair: signed:i8, unsigned:u8
res raw, field, 4
res pairs, field, Pair[2]
med raw_m, raw, field
med pairs_m, pairs, field
mov.i8 %r0, 0xff
print %r0
mov.u8 %r1, 0x000ff
print %r1
store.i8 [raw_m + 0], %r0
load.i8 %r2, [raw_m + 0]
print %r2
store.u8 [raw_m + 1], %r1
load.u8 %r2, [raw_m + 1]
print %r2
store.i8 [pairs_m + 0].signed, %r0
store.u8 [pairs_m + 0].unsigned, %r1
load.i8 %r3, [pairs_m + 0].signed
print %r3
load.u8 %r4, [pairs_m + 0].unsigned
print %r4
view raw_v_m, raw_m, 1, 2
mov %r5, 511
store.u8 [raw_v_m + 0], %r5
load.u8 %r6, [raw_v_m + 0]
print %r6
mov.i8 %r7, %r1
print %r7
mov.u8 %r7, %r0
print %r7
ret
