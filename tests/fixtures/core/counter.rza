; counter: proc вызывается 3 раза; field-ячейка и её медиатор
; доступны из proc (SCOPE).
res  counter, field, 8
med  counter_m, counter, field

mov  %r0, 0
store [counter_m + 0], %r0

proc tick:
    load  %r0, [counter_m + 0]
    inc   %r0
    store [counter_m + 0], %r0
    load  %r1, [counter_m + 0]
    print %r1                  ; вызовы 1..3: каждый +1 к field-ячейке → 1, 2, 3
    ret

call tick
call tick
call tick
ret
