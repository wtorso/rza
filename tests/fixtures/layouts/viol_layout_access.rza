layout Entry: key:i64, value:i64
res entries, field, Entry[2]
res raw, field, 8
med entries_m, entries, field
med raw_m, raw, field
load %r0, [entries_m + 0]
load %r0, [entries_m + 0].missing
loadb %r0, [entries_m + 0].key
storeb [entries_m + 0].value, %r0
store [raw_m + 0].key, %r0
load %r0, [entries_m + 0].key.extra
