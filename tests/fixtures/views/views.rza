res raw, field, 32
med raw_m, raw, field
layout Entry: key:i64, value:i64
res entries, field, Entry[4]
med entries_m, entries, field
mov %r0, 8
mov %r1, 40
store [raw_m + 8], %r1
view raw_v_m, raw_m, %r0, 16
load %r2, [raw_v_m + 0]
print %r2
view nested_m, raw_v_m, 4, 8
mov %r3, 41
store [nested_m + 0], %r3
load %r4, [raw_v_m + 4]
print %r4
view empty_m, raw_m, 32, 0
probe empty_m
mov %r5, 1
mov %r6, 42
store [entries_m + 1].key, %r5
store [entries_m + 1].value, %r6
view entries_v_m, entries_m, 1, 2
load %r7, [entries_v_m + 0].value
print %r7
proc typed_read:
    load %r0, [entries_v_m + 0].key
    print %r0
    ret
proc local_read:
    mov %r0, 1
    view local_entries_m, entries_m, %r0, 1
    load %r1, [local_entries_m + 0].value
    print %r1
    ret
call typed_read
call local_read
casc write: raw_v_m -> total[field]
    mov %r1, 99
    store [raw_v_m + 8], %r1
endc
load %r8, [raw_m + 16]
print %r8
res dst, field, 8
med dst_m, dst, field
view dst_v_m, dst_m, 0, 8
acasc copy: raw_v_m,dst_v_m -> async_out
    load %r0, [raw_v_m + 8]
    store [dst_v_m + 0], %r0
endc
await %r9
load %r10, [dst_m + 0]
print %r10
