res x, field, 8
med x_m, x, field
mov %r2, 2
loop:
acasc bump: x_m -> out
    load %r0, [x_m + 0]
    inc %r0
    store [x_m + 0], %r0
endc
await %r0
slt %r3, %r2, 2
brnz %r3, published
med out_m, out, field
mov %r4, 4
view tail_m, out_m, %r4, %r4
published:
mov %r0, 3
loadb %r1, [tail_m + %r0]
dec %r2
brnz %r2, loop
mov %r0, 4
loadb %r1, [tail_m + %r0]
ret
