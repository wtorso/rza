res x, field, 8
med x_m, x, field
proc worker:
    acasc bump: x_m -> out
        load %r0, [x_m + 0]
        inc %r0
        store [x_m + 0], %r0
    endc
    med out_m, out, field
    acasc blocked: out_m -> blocked_out
        load %r0, [out_m + 0]
    endc
    med blocked_out_m, blocked_out, field
    probe blocked_out_m          ; DEAD: abort не публикует OUT
    await %r0
    print %r0                    ; 1: bump завершён, blocked пропущен
    probe blocked_out_m          ; DEAD: после abort тоже нет публикации
    ret
call worker
ret
