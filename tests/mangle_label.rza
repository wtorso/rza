; манглинг меток (review #3): метка верхнего уровня c1_x и метка x
; внутри каскада №1 — РАЗНЫЕ метки. Раньше обе схлопывались в L_c1_x:
; дубль метки в сгенерированном C (не компилируется).
cav  a, field
res  x, a, 8
med  x_m, x, a
casc c1: x_m -> o1[a]
    jmp x
x:
endc
mov  %r0, 7
jmp  c1_x
mov  %r0, 0
c1_x:
print %r0          ; 7: jmp c1_x пропустил mov %r0, 0 — осталась константа
                   ; первого mov
ret
