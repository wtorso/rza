layout Pair: tag:u8, half:i16, guard:u16, word:i64
res pairs, field, Pair[2]
med pairs_m, pairs, field
mov.u8 %r0, 1
store.u8 [pairs_m + 0].tag, %r0
mov.i16 %r1, -2
mov.u16 %r6, 0x5a5a
store.u16 [pairs_m + 0].guard, %r6
store.i16 [pairs_m + 0].half, %r1
store.i16 [pairs_m + 1].half, %r1
mov %r2, 42
store [pairs_m + 0].word, %r2
load.u8 %r3, [pairs_m + 0].tag
print %r3
load.i16 %r4, [pairs_m + 0].half
print %r4
load.i16 %r4, [pairs_m + 1].half
print %r4
load.u16 %r6, [pairs_m + 0].guard
print %r6
load %r5, [pairs_m + 0].word
print %r5
view pairs_v_m, pairs_m, 1, 1
load.i16 %r6, [pairs_v_m + 0].half
print %r6
ret
